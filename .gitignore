# ==========================================
# EVE MONO-REPO - GITIGNORE (Hardened)
# ==========================================

# --- [ 1. SECRETS & SECURITY ] ---
# Block anything that smells like plaintext
*.env
*.tfvars
*.tfvars.json
auth.tf
*.key
*.pem
*.pub
.ssh/
.sops/
age.key

# EXCEPTIONS: Encrypted files that SHOULD be committed
!secrets.enc.yaml
!.sops.yaml

# --- [ 2. TERRAFORM ] ---
# Plugin directories and local state files
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log

# --- [ 3. ANSIBLE ] ---
# Logs and temporary execution files
*.log
*.retry
ansible.log
.ansible_cache/

# --- [ 4. SYSTEM & EDITORS ] ---
.DS_Store
Thumbs.db
core
*.swp
*.swo
.vscode/
.idea/

# --- [ 5. OTHER ] ---
# Temporary deployment files
dist/
build/

# --- [ 6. BACKUPS ] ---
*.orig
*.bak

# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
.pytest_cache/
