# ==========================================
# EVE MONO-REPO - GITIGNORE (Hardened)
# ==========================================

# --- [ 1. SECRETOS Y SEGURIDAD ] ---
# Bloqueamos todo lo que huela a texto plano
*.env
*.tfvars
*.tfvars.json
auth.tf
*.key
*.pem
*.pub
.ssh/
.sops/
age.key

# EXCEPCIONES: Archivos encriptados que SÍ deben ir al repo
!secrets.enc.yaml
!.sops.yaml

# --- [ 2. TERRAFORM ] ---
# Directorios de plugins y estados locales
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log

# --- [ 3. ANSIBLE ] ---
# Logs y archivos temporales de ejecución
*.log
*.retry
ansible.log
.ansible_cache/

# --- [ 4. SISTEMA Y EDITORES ] ---
.DS_Store
Thumbs.db
core
*.swp
*.swo
.vscode/
.idea/

# --- [ 5. OTROS ] ---
# Archivos temporales de despliegue
dist/
build/

# --- [ 6. BACKUPS ] ---
*.orig
*.bak

