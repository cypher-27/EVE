#!/bin/bash

# ==========================================
# EVE GATEWAY - SDN FIREWALL (Ansible Managed)
# ==========================================

# Variables injected by Ansible
WG_IFACE="{{ wg_iface }}"
ZT_IFACE="{{ zt_iface }}"
LAN_IFACE="{{ lan_iface }}"
LAN_SUBNET="{{ lan_subnet }}"
RASP_LAN_IP="{{ rasp_lan_ip }}"

# 1. Cleanup
iptables -F
iptables -X
iptables -t nat -F
iptables -t nat -X

# Set default policy to DROP as a safety net — if for some reason
# the script exits before reaching the explicit catch-all at the end,
# the system doesn't stay open due to Linux's default (ACCEPT).
iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -P OUTPUT ACCEPT

# 2. NAT
iptables -t nat -A POSTROUTING -o $LAN_IFACE -j MASQUERADE

# 3. INPUT Rules (Pi Security)
iptables -A INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT
iptables -A INPUT -i lo -j ACCEPT
iptables -A INPUT -i $ZT_IFACE -j ACCEPT
iptables -A INPUT -p udp --dport 51820 -j ACCEPT
iptables -A INPUT -p tcp --dport 22 -j ACCEPT
iptables -A INPUT -j DROP

# 4. FORWARD Rules (Forwarding)
iptables -A FORWARD -m state --state RELATED,ESTABLISHED -j ACCEPT

# Allow the LAN to reach the internet via the uplink interface
iptables -A FORWARD -s $LAN_SUBNET -o $LAN_IFACE -j ACCEPT

# --- DYNAMIC ZONE: GENERATED FROM LAB-STATE.YAML ---
{% for env in entornos_activos %}
{% if env.estado == "presente" %}

# Rules for: {{ env.nombre }} (IP: {{ env.red.ip.split('/')[0] }})
# We use | default([]) so it doesn't blow up if 'firewall_externo' doesn't exist
{% for rule in env.firewall_externo | default([]) %}

# {{ rule.descripcion | default(rule.protocolo + ':' + rule.puerto | string) }}
iptables -A FORWARD -i $WG_IFACE -d {{ env.red.ip.split('/')[0] }} -p {{ rule.protocolo }} --dport {{ rule.puerto }} -j ACCEPT
iptables -A FORWARD -i $ZT_IFACE -d {{ env.red.ip.split('/')[0] }} -p {{ rule.protocolo }} --dport {{ rule.puerto }} -j ACCEPT
{% endfor %}
{% endif %}
{% endfor %}

# --- FINAL SECURITY ---
# Allow global PING for monitoring
iptables -A FORWARD -p icmp -j ACCEPT

# Total block to the rest of the LAN (Default Drop for VPNs)
iptables -A FORWARD -i $WG_IFACE -d $LAN_SUBNET -j DROP
iptables -A FORWARD -i $ZT_IFACE -d $LAN_SUBNET -j DROP

# Catch-all: anything not explicitly allowed above gets dropped.
# (FORWARD policy stays ACCEPT by Linux default if not set here;
# without this line, the allowlist above is purely decorative.)
iptables -A FORWARD -j DROP

echo "EVE Firewall: SDN dynamically updated from the master contract."
