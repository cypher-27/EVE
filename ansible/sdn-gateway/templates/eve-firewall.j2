#!/bin/bash

# ==========================================
# EVE GATEWAY - SDN FIREWALL (Ansible Managed)
# ==========================================

# Variables inyectadas por Ansible
WG_IFACE="{{ wg_iface }}"
ZT_IFACE="{{ zt_iface }}"
LAN_IFACE="{{ lan_iface }}"
LAN_SUBNET="{{ lan_subnet }}"
RASP_LAN_IP="{{ rasp_lan_ip }}"

# 1. Limpieza
iptables -F
iptables -X
iptables -t nat -F
iptables -t nat -X

# Fijar politica default a DROP como respaldo — si por alguna razon
# el script termina antes de llegar al catch-all explicito al final,
# no queda el sistema abierto por default de Linux (ACCEPT).
iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -P OUTPUT ACCEPT

# 2. NAT
iptables -t nat -A POSTROUTING -o $LAN_IFACE -j MASQUERADE

# 3. Reglas INPUT (Seguridad de la Pi)
iptables -A INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT
iptables -A INPUT -i lo -j ACCEPT
iptables -A INPUT -i $ZT_IFACE -j ACCEPT
iptables -A INPUT -p udp --dport 51820 -j ACCEPT
iptables -A INPUT -p tcp --dport 22 -j ACCEPT
iptables -A INPUT -j DROP

# 4. Reglas FORWARD (Reenvío)
iptables -A FORWARD -m state --state RELATED,ESTABLISHED -j ACCEPT

# Permitir que la LAN salga a internet vía la interfaz de uplink
iptables -A FORWARD -s $LAN_SUBNET -o $LAN_IFACE -j ACCEPT

# --- ZONA DINÁMICA: GENERADA DESDE LAB-STATE.YAML ---
{% for env in entornos_activos %}
{% if env.estado == "presente" %}

# Reglas para: {{ env.nombre }} (IP: {{ env.red.ip.split('/')[0] }})
# Usamos | default([]) para que si no existe 'firewall_externo', no explote
{% for rule in env.firewall_externo | default([]) %}

# {{ rule.descripcion | default(rule.protocolo + ':' + rule.puerto | string) }}
iptables -A FORWARD -i $WG_IFACE -d {{ env.red.ip.split('/')[0] }} -p {{ rule.protocolo }} --dport {{ rule.puerto }} -j ACCEPT
iptables -A FORWARD -i $ZT_IFACE -d {{ env.red.ip.split('/')[0] }} -p {{ rule.protocolo }} --dport {{ rule.puerto }} -j ACCEPT
{% endfor %}
{% endif %}
{% endfor %}

# --- SEGURIDAD FINAL ---
# Permitir PING global para monitoreo
iptables -A FORWARD -p icmp -j ACCEPT

# Bloqueo total al resto de la LAN (Default Drop para VPNs)
iptables -A FORWARD -i $WG_IFACE -d $LAN_SUBNET -j DROP
iptables -A FORWARD -i $ZT_IFACE -d $LAN_SUBNET -j DROP

# Catch-all: cualquier cosa no permitida explícitamente arriba, se descarta.
# (FORWARD policy queda en ACCEPT por default de Linux si no se fija aquí;
# sin esta línea, la allowlist de arriba es decorativa.)
iptables -A FORWARD -j DROP

echo "EVE Firewall: SDN actualizado dinámicamente desde el contrato maestro."
