# /etc/conf.d/victoria-metrics
# Generado automáticamente por el Orquestador EVE

ARGS="-storageDataPath=/var/lib/victoria-metrics \
-retentionPeriod=7d \
-promscrape.configInline='
scrape_configs:
  - job_name: \"eve-cluster\"
    static_configs:
      - targets: [
{% for host in groups['eve_dynamic_nodes'] %}
        \"{{ hostvars[host].ansible_host }}:9100\"{{ \",\" if not loop.last else \"\" }}
{% endfor %}
      ]
'"

